# 后端专用配置，不要放到 client/，不要提交真实 .env

# 不配置 LLM_API_KEY 时，后端会自动启用 mock 模式
LLM_API_KEY=

# OpenAI-compatible 中转站示例：
# LLM_API_FORMAT=openai
# LLM_BASE_URL=https://your-relay.example.com/v1
# LLM_MODEL=your-openai-compatible-model

# Claude / Anthropic Messages 格式中转站示例：
LLM_API_FORMAT=claude
LLM_BASE_URL=https://your-relay.example.com/v1
LLM_MODEL=claude-sonnet-4-6

# 可选：真实 LLM 请求超时时间，单位毫秒
LLM_TIMEOUT_MS=15000

# 后端端口
PORT=3001
