# 后端专用配置示例。复制为 .env 后填值。不要提交真实 .env。

# ---- LLM ----
# 不配置 LLM_API_KEY 时,后端自动启用 mock 模式(本地测试 / E2E 跑通)。
LLM_API_KEY=

# OpenAI-compatible 中转站(默认):
# LLM_API_FORMAT=openai
# LLM_BASE_URL=https://your-relay.example.com/v1
# LLM_MODEL=gpt-4o-mini

# Claude / Anthropic Messages 格式中转站:
# LLM_API_FORMAT=claude
# LLM_BASE_URL=https://your-relay.example.com
# LLM_MODEL=claude-3-5-sonnet

# 可选:LLM 调用相关
# LLM_TIMEOUT_MS=15000
# LLM_MAX_RETRIES=2
# LLM_RETRY_BASE_MS=300
# LLM_RETRY_MAX_MS=3000
# LLM_RETRY_JITTER_MS=200

# ---- Embedding(记忆向量检索)----
# hash(默认):本地 hash trick,零成本,语义弱
# openai:走 LLM_BASE_URL 的 /embeddings endpoint,需中转支持 OpenAI 协议
# EMBEDDING_PROVIDER=openai

# 默认 text-embedding-3-small(支持 dimensions 参数截断到 128 维以匹配存储格式)
# EMBEDDING_MODEL=text-embedding-3-small

# 可选独立 endpoint(默认复用 LLM_BASE_URL / LLM_API_KEY)
# OPENAI_EMBEDDING_BASE_URL=https://your-relay.example.com/v1
# OPENAI_EMBEDDING_API_KEY=

# ---- Observability ----
# 可选:LLM/embedding 调用 ring buffer 大小,默认 1000
# OBSERVABILITY_BUFFER_SIZE=1000

# ---- 服务端口 ----
PORT=3001

# ---- Debug API ----
# 开启 /api/debug/metrics 等调试 endpoint(NODE_ENV=production 时默认关闭)
# ENABLE_DEBUG_API=true
